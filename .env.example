# Supabase (optional — falls back to browser localStorage when unset)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISH_KEY=your-publish-key

# Server-side only — never prefix with VITE_ (do not expose in the browser bundle)
SUPABASE_SECRET_KEY=your-secret-key

# Legacy API base URL (reserved for a future backend)
VITE_API_BASE_URL=http://localhost:8080/api
